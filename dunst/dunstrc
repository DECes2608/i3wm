[global]
    # Font
    font = Monospace 11

    # Boyut ve konum
    width = (0, 320)
    height = 110
    origin = top-right
    offset = 12x12
    notification_limit = 5
    sort = yes

    # Görünüm (Sert köşeli ve monokrom)
    corner_radius = 0
    border_size = 1
    padding = 12
    horizontal_padding = 16
    frame_width = 1
    gap_size = 6

    # Davranış
    idle_threshold = 0
    show_age_threshold = 60
    sticky_history = yes
    history_length = 20

    # İkonlar
    icon_position = left
    max_icon_size = 40
    icon_path = /usr/share/icons/Papirus-Dark/16x16/status/:/usr/share/icons/Papirus-Dark/16x16/devices/

    # İlerleme çubuğu (Progress bar)
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0

[urgency_low]
    background = "#0a0a0a"
    foreground = "#8a8a8a"
    frame_color = "#333333"
    timeout = 3

[urgency_normal]
    background = "#0d0d0d"
    foreground = "#e8e8e8"
    frame_color = "#4a4a4a"
    highlight = "#6a6a6a"
    timeout = 5

[urgency_critical]
    background = "#000000"
    foreground = "#ffffff"
    frame_color = "#999999"
    timeout = 0
